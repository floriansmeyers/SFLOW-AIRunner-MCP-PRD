# === Authentication (REQUIRED for production use) ===
# Dashboard basic auth - protects the web UI
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-a-strong-password

# === OAuth 2.1 (optional - auto-generated if not set) ===
# Static OAuth credentials for MCP SSE endpoints
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_SECRET_KEY=your-secret-key-for-jwt-signing

# === Transport ===
# Options: "both" (default), "sse", "stdio"
# MCP_TRANSPORT=both

# === ngrok (optional - enables remote access) ===
# NGROK_AUTHTOKEN=your-ngrok-authtoken

# === Public URL (optional - overrides ngrok/localhost for OAuth callbacks) ===
# PUBLIC_URL=https://your-domain.com
